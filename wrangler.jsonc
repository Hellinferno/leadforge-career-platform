{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "leadforge-personal",
  "main": "worker.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "vars": {
    "OWNER_NAME": "Ravi"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "leadforge-personal-db",
      "database_id": "69a151c9-bed3-4642-b3ac-d51c1addf3fe",
      "migrations_dir": "drizzle"
    }
  ]
}
